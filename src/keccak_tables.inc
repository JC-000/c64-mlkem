        .byte $00, $50, $A0, $28, $78
        .byte $80, $08, $58, $A8, $30
        .byte $38, $88, $10, $60, $B0
        .byte $B8, $40, $90, $18, $68
        .byte $70, $C0, $48, $98, $20
